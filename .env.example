# Copie para .env. Valores apenas de desenvolvimento local.
ENCAIXE_ENV=dev
ENCAIXE_DATABASE_URL=postgresql://encaixe_app:encaixe_app_dev@localhost:55432/encaixe
ENCAIXE_DATABASE_ADMIN_URL=postgresql://postgres:postgres_dev@localhost:55432/encaixe
ENCAIXE_REDIS_URL=redis://localhost:56379/0
ENCAIXE_OLLAMA_BASE_URL=http://localhost:11434
ENCAIXE_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# Telemetria desligada (100% local)
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
PHOENIX_TELEMETRY_ENABLED=false

# Execução offline: modelos HF são baixados por `make models` (scripts/pull-models.sh);
# o Makefile (api/worker) já exporta estas variáveis.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Usado pelo docker-compose
POSTGRES_PASSWORD=postgres_dev
ENCAIXE_APP_PASSWORD=encaixe_app_dev
