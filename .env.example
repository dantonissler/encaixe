# Copie para .env. Valores apenas de desenvolvimento local.
# dev aceita o header X-Encaixe-Model (troca de modelo da disputa); prod o ignora.
# PILOTO/PRODUÇÃO: use prod. Em dev, qualquer portador de uma chave escolhe o modelo do Ollama.
ENCAIXE_ENV=dev
ENCAIXE_DATABASE_URL=postgresql://encaixe_app:encaixe_app_dev@localhost:55432/encaixe
ENCAIXE_DATABASE_ADMIN_URL=postgresql://postgres:postgres_dev@localhost:55432/encaixe
ENCAIXE_REDIS_URL=redis://localhost:56379/0
ENCAIXE_OLLAMA_BASE_URL=http://localhost:11434
ENCAIXE_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# A API aquece reranker e modelos do Ollama antes de atender; false desliga.
# ENCAIXE_WARMUP=true
# Resultado de ferramenta MCP acima disto é cortado com "[resultado truncado]".
# ENCAIXE_TOOL_RESULT_MAX_CHARS=4000

# Telemetria desligada (100% local)
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
PHOENIX_TELEMETRY_ENABLED=false

# Execução offline: modelos HF são baixados por `make models` (scripts/pull-models.sh);
# o Makefile (api/worker) já exporta estas variáveis.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Usado pelo docker-compose: senha do superusuário postgres (a mesma de ENCAIXE_DATABASE_ADMIN_URL).
POSTGRES_PASSWORD=postgres_dev
# A senha do papel encaixe_app (a de ENCAIXE_DATABASE_URL) é definida em docker/postgres/init.sql,
# que só roda na criação do volume. Para trocá-la, edite os dois antes do primeiro `make up`.

# Perfil ui (Open WebUI): chave de `uv run encaixe keys create --app exemplo`.
# ENCAIXE_WEBUI_API_KEY=enc_...
