#!/usr/bin/env bash
# Roda `make eval` para cada app com mudança em apps/<id>/ desde o upstream.
# Instalado por `make hooks`. Para pular em caso de emergência: git push --no-verify.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [ -z "$base" ]; then
  base=$(git rev-parse --verify -q origin/main || git rev-parse --verify -q origin/master || true)
fi
if [ -n "$base" ]; then
  changed=$(git diff --name-only "$base"...HEAD -- apps/)
else
  changed=$(git ls-files apps/)  # primeiro push: avalia todos os apps
fi

apps=$(printf '%s\n' "$changed" | awk -F/ 'NF>=3 && $1=="apps" {print $2}' | sort -u)
[ -n "$apps" ] || exit 0

if ! curl -fsS --max-time 5 http://localhost:8100/health >/dev/null 2>&1; then
  cat >&2 <<MSG
pre-push: a API não responde em http://localhost:8100/health.
Há mudanças em: $(echo $apps | tr '\n' ' ')
Suba a stack (make up && make migrate && make api && make worker), exporte
ENCAIXE_EVAL_API_KEY (uv run encaixe seed --app <id>) e tente de novo.
Para pular: git push --no-verify
MSG
  exit 1
fi

for app in $apps; do
  [ -f "apps/$app/evals/promptfooconfig.yaml" ] || continue
  echo "pre-push: avaliando o app '$app'..."
  make eval APP="$app"
done
